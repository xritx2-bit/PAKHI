# ==============================================================================
# PAKHI'S COLLECTION — PRODUCTION ENVIRONMENT TEMPLATE
# Supporting Dual-Host Deployment (Separate Customer & Admin Hosts via Subdomain)
# ==============================================================================

# 1. DATABASE CONNECTION (Shared by both Customer and Admin hosts)
# SQLite for local dev; PostgreSQL / Supabase / Neon / AWS RDS for production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@ep-cool-db.us-east-1.aws.neon.tech/pakhis_db?sslmode=require"

# 2. SEPARATE HOST & SUBDOMAIN CONFIGURATION
# Customer Storefront Host:
NEXT_PUBLIC_SITE_URL="https://pakhiscollection.com"
# Admin Executive Console Host:
NEXT_PUBLIC_ADMIN_URL="https://admin.pakhiscollection.com"
# Subdomain identifier recognized by Next.js middleware:
ADMIN_DOMAIN="admin."

# 3. DEPLOYMENT TARGET MODE
# - 'unified'    : Default for local development (serves storefront and /admin)
# - 'storefront' : Production host for customers (blocks /admin from consumer access)
# - 'admin'      : Production host for administrative staff (rewrites / to executive console)
APP_MODE="unified"

# 4. ADMINISTRATIVE & SECURITY KEYS
ADMIN_SECRET_KEY="super-secret-admin-token-key-change-in-production"
AUTH_SALT="pakhi_salted_sha256_secret_key"

# 5. PAYMENT GATEWAY (Razorpay / Cashfree / Stripe)
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# 6. LOGISTICS & NOTIFICATIONS (Blue Dart / Delhivery & SMS OTP Gateway)
BLUEDART_CUSTOMER_CODE="BLUEDART_CORP_12345"
BLUEDART_API_KEY="sandbox_bluedart_api_key"
SMS_GATEWAY_API_KEY="your_sms_api_key"
